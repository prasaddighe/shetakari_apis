# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=super-secret-jwt-key-change-in-production-12345

# Real SMS Gateway API Key (Optional: Fast2SMS for Indian Mobile Numbers)
FAST2SMS_API_KEY=

# Database Type
DB_TYPE=mysql

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=users
DB_USER=root
DB_PASSWORD=root

# MySQL Connection String URL
DATABASE_URL=mysql://root:root@localhost:3306/users
